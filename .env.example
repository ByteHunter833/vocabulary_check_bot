# Telegram bot token from @BotFather. Leave empty to run the API only.
BOT_TOKEN=
# Railway Postgres provides DATABASE_URL in postgresql:// form;
# the app auto-converts it to postgresql+asyncpg://.
DATABASE_URL=postgresql+asyncpg://vocab:vocab@localhost:5432/vocab
# Comma-separated numeric Telegram user IDs. Never hardcode them in code.
ADMIN_TELEGRAM_IDS=123456789,987654321
SUPER_ADMIN_TELEGRAM_IDS=
OCR_PROVIDER=tesseract
OCR_API_KEY=
APP_ENV=development
LOG_LEVEL=INFO
DEFAULT_TIME_LIMIT_SECONDS=60
# Railway sets PORT automatically; used only by local Docker runs.
PORT=8000
